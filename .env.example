NODE_ENV=development
PORT=8080
API_BASE_PATH=/api/v1
PASSWORD_RESET_REDIRECT_URL=http://localhost:8080/reset-password
GOOGLE_OAUTH_REDIRECT_URL=http://localhost:5500/FOODSAVE_USER.html
FACEBOOK_OAUTH_REDIRECT_URL=http://localhost:5500/FOODSAVE_USER.html
GOOGLE_OTP_EXPIRES_SECONDS=600
PHONE_OTP_EXPIRES_SECONDS=600
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:5500,http://127.0.0.1:5500
SOCKET_CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8081,http://10.0.2.2:8081
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=info

MOMO_API_BASE_URL=https://test-payment.momo.vn/v2/gateway/api
MOMO_PARTNER_CODE=MOMO
MOMO_ACCESS_KEY=YOUR_MOMO_TEST_ACCESS_KEY
MOMO_SECRET_KEY=YOUR_MOMO_TEST_SECRET_KEY
MOMO_REDIRECT_URL=http://localhost:5500/FOODSAVE_USER.html
MOMO_IPN_URL=http://localhost:8080/api/v1/orders/payments/momo/webhook/mock

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=foodsave
DATABASE_USER=postgres
DATABASE_PASSWORD=foodsave_secure_local_password
DATABASE_SSL=false
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Production alternative for managed Postgres/Supabase direct connection.
# When DATABASE_URL is set, it takes precedence over DATABASE_HOST/PORT/NAME/USER/PASSWORD.
# DATABASE_URL=postgresql://postgres:password@db.example.supabase.co:5432/postgres

# Chu kỳ tác vụ đổi nhãn khi chạy ở máy (ms), 0 = tắt
LABEL_AUTOMATION_INTERVAL_MS=300000

# --- Ảnh minh chứng của tình nguyện viên ---
# Thời hạn tổ chức duyệt ảnh (phút) trước khi tự gửi sang cửa hàng. Mặc định 360 (6 tiếng). Khi demo đặt 2.
PHOTO_REVIEW_MINUTES=360
# true = TNV được tải ảnh từ thư viện (CHỈ để demo trên laptop). Bản thật để false.
DEMO_MODE=false
# Ảnh chụp cách cửa hàng / tổ chức quá số mét này thì bị gắn cờ lệch vị trí
PHOTO_GPS_MAX_METERS=500

# --- Marketing Studio / n8n (Facebook) ---
# Địa chỉ webhook của workflow n8n số 2 (để trống = chỉ báo cho người mua trong FoodSave, không đăng mạng xã hội)
# N8N_WEBHOOK_URL=http://localhost:5678/webhook/foodsave-promote
# Mật khẩu chung với n8n (header x-n8n-secret)
# N8N_SECRET=doi-mat-khau-nay
# Địa chỉ trang người mua dùng làm link trong bài đăng
# PUBLIC_SITE_URL=https://ten-mien-cua-ban/FOODSAVE_USER.html
# Phương án dự phòng: n8n không gọi được thì FoodSave đăng Facebook trực tiếp. JSON {"MA_FANPAGE":"TOKEN_FANPAGE"}
# FACEBOOK_PAGE_TOKENS={"123456789":"EAAB..."}

# --- AI Agent đăng bài (Fanpage trung tâm FoodSave) ---
# Mã Fanpage trung tâm và tên hiển thị trên trang Admin
CENTRAL_PAGE_ID=MA_FANPAGE_FOODSAVE
CENTRAL_PAGE_NAME=Fanpage FoodSave
# Webhook n8n của workflow Fanpage FoodSave (nút "Chạy thử ngay"). Trống = suy ra từ N8N_WEBHOOK_URL
# N8N_CENTRAL_WEBHOOK_URL=https://TEN-N8N-CLOUD.app.n8n.cloud/webhook/foodsave-central
# Gemini: KHÔNG đặt ở đây. Key Gemini chỉ nằm trong Credentials của n8n.
