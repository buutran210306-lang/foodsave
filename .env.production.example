NODE_ENV=production
PORT=8080
API_BASE_PATH=/api/v1

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
PASSWORD_RESET_REDIRECT_URL=https://YOUR_FRONTEND_DOMAIN/reset-password

CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN
SOCKET_CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
LOG_LEVEL=info

DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true
DATABASE_SSL_REJECT_UNAUTHORIZED=false
